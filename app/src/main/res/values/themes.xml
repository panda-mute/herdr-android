<resources>
    <style name="Theme.Herdr" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The share target, which shows nothing: it hands what was shared to the app and closes. -->
    <style name="Theme.Herdr.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>

    <!-- The status widget's counts: a big number with its words beside it. -->
    <style name="HerdrWidgetCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">–</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="HerdrWidgetUsage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="HerdrWidgetCountWords">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- A row's button in the Needs you widget: square, its label in mono, as the app's buttons. -->
    <style name="HerdrWidgetButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/geist_mono_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxWidth">112dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
