def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    rest = argv[2:]
    if WINDOWS and hasattr(sys.stdout, "reconfigure"):
        # A pipe there is in the ANSI code page, which has no block characters for the QR code.
        sys.stdout.reconfigure(encoding="utf-8")
    if cmd == "run":
        return run()
    if cmd == "subscribe":
        return cmd_subscribe()
    if cmd == "unsubscribe" and rest:
        return cmd_unsubscribe(rest[0])
    if cmd == "test":
        return cmd_test(rest[0] if rest else None)
    if cmd == "status":
        return cmd_status()
    if cmd == "ensure":
        return cmd_ensure()
    if cmd == "install":
        return cmd_install()
    if cmd == "uninstall":
        return cmd_uninstall("--purge" in rest)
    if cmd == "once":
        return cmd_once("--dry-run" in rest)
    if cmd == "journal":
        session = rest[rest.index("--session") + 1] if "--session" in rest[:-1] else None
        try:
            since = float(rest[rest.index("--since") + 1]) if "--since" in rest[:-1] else 0
        except ValueError:
            since = 0
        return cmd_journal(session, since)
    if cmd == "presence":
        return cmd_presence()
    if cmd == "pair":
        return cmd_pair(rest)
    if cmd == "pair-accept":
        return cmd_pair_accept(rest)
    if cmd == "version":
        print(VERSION)
        return 0
    if cmd == "_qr" and len(rest) == 1:  # for the app's QR test: the code's modules, 1 dark, a row a line
        print("\n".join("".join(map(str, row)) for row in qr_matrix(rest[0])))
        return 0
    if cmd == "_seal" and len(rest) == 2:  # for the app's interop test: key (base64) and JSON
        print(seal_message(base64.b64decode(rest[0]), json.loads(rest[1])))
        return 0
    sys.stdout.write(__doc__)
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
