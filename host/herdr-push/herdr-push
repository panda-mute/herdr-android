def hc_socket():
    """The default core's socket as hc finds it: HC_SOCKET, what the running core wrote in core.lock, the runtime folder."""
    if os.environ.get("HC_SOCKET"):
        return os.environ["HC_SOCKET"]
    sess = os.environ.get("HC_SESSION") or "default"
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "herdr-core", sess)
    try:
        with open(os.path.join(state, "core.lock")) as f:
            s = f.readline().strip()
        if s and os.path.exists(s):
            return s
    except OSError:
        pass
    run = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    if os.path.isdir(run):
        return os.path.join(run, "herdr-core", sess + ".sock")
    return os.path.join(state, sess + ".sock")


class HerdrCore:
    """herdr-core's API on its socket, one JSON-RPC line each way. Connecting to it never starts a core
    (`hc` itself would), so a machine whose owner doesn't use the desktop app gets none."""

    def __init__(self, path):
        self.path = path
        self.sock = None
        self.f = None
        self.n = 0

    def call(self, method, params=None):
        if self.f is None:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            # Short: a core that doesn't answer mustn't hold up classic herdr's notifications.
            s.settimeout(3)
            try:
                s.connect(self.path)
            except OSError:
                s.close()
                raise
            self.sock, self.f = s, s.makefile("rwb")
            self._rpc("hello", {"generation": 1})
        return self._rpc(method, params or {})

    def _rpc(self, method, params):
        self.n += 1
        self.f.write((json.dumps({"jsonrpc": "2.0", "id": self.n, "method": method, "params": params}) + "\n").encode())
        self.f.flush()
        while True:
            line = self.f.readline()
            if not line:
                raise RuntimeError("herdr-core closed the connection")
            out = json.loads(line.decode(errors="replace"))
            # A late answer to a call that timed out isn't this one's.
            if out.get("id") == self.n:
                break
        if out.get("error"):
            raise RuntimeError(out["error"].get("message") or "herdr-core: error")
        return out.get("result") or {}

    def close(self):
        for c in (self.f, self.sock):
            try:
                if c:
                    c.close()
            except OSError:
                pass
        self.sock = self.f = None

    def screen(self, address):
        return self.call("terminal.read", {"terminal": address, "lines": 0}).get("text", "")


def herdr_core_exe():
    """Windows: where herdr-core.exe is, on the PATH or where its installer puts it; None when it isn't there."""
    exe = shutil.which("herdr-core")
    if not exe:
        exe = os.path.join(os.environ.get("LOCALAPPDATA") or "", "Programs", "herdr-core", "herdr-core.exe")
    return exe if os.path.isfile(exe) else None


class HcPipe:
    """herdr-core's API through `herdr-core connect` (JSON-RPC lines over its stdin and stdout), for Windows, where the
    core has no Unix socket. Same calls as HerdrCore. It never starts a core: the caller checks one runs first."""

    def __init__(self, exe):
        self.exe = exe
        self.proc = None
        self.lines = None
        self.n = 0

    def call(self, method, params=None):
        if self.proc is None:
            self.proc = subprocess.Popen([self.exe, "connect"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, creationflags=NO_WINDOW)
            self.lines = queue.Queue()
            # A pipe has no read timeout: a thread reads it and the calls wait on the queue.
            threading.Thread(target=self._read, args=(self.proc.stdout, self.lines), daemon=True).start()
            self._rpc("hello", {"generation": 1})
        return self._rpc(method, params or {})

    @staticmethod
    def _read(f, lines):
        try:
            for line in f:
                lines.put(line)
        except (OSError, ValueError):
            pass
        lines.put(None)

    def _rpc(self, method, params):
        self.n += 1
        try:
            self.proc.stdin.write((json.dumps({"jsonrpc": "2.0", "id": self.n, "method": method, "params": params}) + "\n").encode())
            self.proc.stdin.flush()
            # Short, as HerdrCore's: a core that doesn't answer mustn't hold up classic herdr's notifications.
            end = time.time() + 3
            while True:
                try:
                    line = self.lines.get(timeout=max(end - time.time(), 0.01))
                except queue.Empty:
                    raise RuntimeError("herdr-core did not answer")
                if line is None:
                    raise RuntimeError("herdr-core closed the connection")
                out = json.loads(line.decode(errors="replace"))
                if out.get("id") == self.n:
                    break
        except Exception:
            # What is left of this connection is of no use: the next call starts a new one.
            self.close()
            raise
        if out.get("error"):
            raise RuntimeError(out["error"].get("message") or "herdr-core: error")
        return out.get("result") or {}

    def close(self):
        p, self.proc = self.proc, None
        if p is None:
            return
        # Killed first: closing stdout waits for the reader thread, which waits for the child. A child that
        # outlives the kill keeps its stdout open rather than hang the watcher.
        try:
            p.kill()
            p.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            pass
        for c in (p.stdin, p.stdout) if p.poll() is not None else (p.stdin,):
            try:
                c.close()
            except (OSError, ValueError):
                pass

    def screen(self, address):
        return self.call("terminal.read", {"terminal": address, "lines": 0}).get("text", "")


def hc_agent_name(t):
    app = ((t.get("status") or {}).get("app") or "").strip().lower()
    if app:
        return {"claude-code": "claude", "claude": "claude", "pi-coding-agent": "pi"}.get(app, app[:-4] if app.endswith("-cli") else app)
    fg = (t.get("foreground") or {}).get("name") or os.path.basename((t.get("argv") or [""])[0])
    return fg if fg in HC_KNOWN else None


def hc_task(t):
    """The Shepherdr 3 task a terminal's agent works on, as people say it (`HERD-8`), or None: its label holds the
    task list's key and number (`data-jpl-Work-app#8`), the ref's letters come from the name herdr-task gives its
    worker (`herd-8-dark-mode`), as the app reads it (core/hc/HcView.kt shepherdrTask)."""
    n = ((t.get("labels") or {}).get("herdr.task") or "").rpartition("#")[2]
    m = re.match(r"^([A-Za-z][A-Za-z0-9]*)-(\d+)(?:-|$)", t.get("name") or "")
    return m.group(1).upper() + "-" + n if n.isdigit() and m and m.group(2) == n else None


def hc_snapshot(terminals):
    """Live terminals as herdr's snapshot has agents: pane ids `hc:<address>`, the desktop app's spaces
    and tabs from its labels (`herdr.space`, `herdr.tab`, `where`), the rest in "Other terminals"."""
    live = [t for t in terminals if t.get("state", "live") == "live" and t.get("address")]
    by = {t["address"]: t for t in terminals if t.get("address")}

    def place(t):
        cur = t
        for _ in range(32):
            labels = cur.get("labels") or {}
            where = (labels.get("where") or "").strip()
            space = labels.get("herdr.space")
            if space or where:
                names = where.split(" / ", 1) if where else []
                sid = HC_PREFIX + (space or "where:" + names[0])
                tab = labels.get("herdr.tab") or (names[1] if len(names) > 1 else cur["address"])
                return (sid, (names[0] if names and names[0] else space or "Space"),
                        sid + "/" + tab, (names[1] if len(names) > 1 and names[1] else tab))
            parent = cur.get("parent")
            if not parent or parent not in by:
                break
            cur = by[parent]
        return HC_PREFIX + "!other", "Other terminals", HC_PREFIX + "!other/tab", "Terminals"

    snap = {"workspaces": [], "tabs": [], "agents": []}
    seen = set()
    for t in sorted(live, key=lambda t: (t.get("created_ms") or 0, t["address"])):
        sid, sname, tid, tname = place(t)
        if sid not in seen:
            seen.add(sid)
            snap["workspaces"].append({"workspace_id": sid, "label": sname})
        if tid not in seen:
            seen.add(tid)
            snap["tabs"].append({"tab_id": tid, "workspace_id": sid, "label": tname})
        status = t.get("status") or {}
        agent = hc_agent_name(t)
        if not status and not agent:
            continue
        word = status.get("state") or "unknown"
        a = {"pane_id": HC_PREFIX + t["address"], "workspace_id": sid, "tab_id": tid, "agent": agent, "display_agent": agent,
             "name": t.get("name"), "title": status.get("msg") or status.get("title") or None,
             "agent_status": "blocked" if word == "error" else word,
             "state_change_seq": t.get("status_ms") or t.get("created_ms") or 0}
        if t.get("turn"):
            a["completion_seq"] = t["turn"]
        # A task's agent: the phone has its task's own alert from Shepherdr ("HERD-8 · Needs you"), one per task.
        task = hc_task(t)
        if task:
            a["shepherdr_task"] = task
        snap["agents"].append(a)
    return snap


def merged(snap, core):
    """herdr's snapshot with herdr-core's agents, spaces and tabs after its own."""
    out = dict(snap)
    for k in ("workspaces", "tabs", "agents"):
        out[k] = list(snap.get(k) or []) + list(core.get(k) or [])
    return out


def trim_screen(text):
    lines = text.rstrip().splitlines()[-40:]
    text = "\n".join(l.rstrip() for l in lines)
    return text[-SCREEN_CHARS:]


def location(snap, agent):
    ws = next((w for w in snap.get("workspaces", []) if w.get("workspace_id") == agent.get("workspace_id")), {})
    tab = next((t for t in snap.get("tabs", []) if t.get("tab_id") == agent.get("tab_id")), {})
    return "%s › %s" % (ws.get("label") or agent.get("workspace_id", ""), tab.get("label") or agent.get("tab_id", ""))


# ---- what changed --------------------------------------------------------------------------------

def agent_events(source, snap, seen, first):
    """Agents that became blocked or done, and ones that were and no longer are. Updates [seen]."""
    events = []
    now = {}
    for a in snap.get("agents", []):
        pane = a.get("pane_id")
        if not pane:
            continue
        status = a.get("agent_status", "unknown")
        now[pane] = status
        before = seen.get(pane)
        if first or status == before:
            continue
        if status in ("blocked", "done") or before in ("blocked", "done"):
            ev = {"type": "agent", "agent": a, "where": location(snap, a)}
            if status == "blocked":
                ev["screen"] = source.screen(pane)
            events.append(ev)
    for pane, before in seen.items():
        if pane not in now and before in ("blocked", "done"):
            events.append({"type": "agent", "agent": {"pane_id": pane, "workspace_id": "", "tab_id": "", "agent_status": "gone"},
                           "where": ""})
    seen.clear()
    seen.update(now)
    return events


def watched(group, field):
    """What the phones of [group] watch ([field]: watch_panes), each with the phones watching it."""
    out = {}
    for s in group:
        for w in s.get(field) or []:
            out.setdefault(str(w), []).append(s["id"])
    return out


def watch_agent_events(snap, seen, watching, told):
    """Watched agents whose status changed (working to idle, say), for the phones watching them."""
    events = []
    now = {}
    for a in snap.get("agents", []):
        pane = a.get("pane_id")
        if pane not in watching:
            continue
        status = a.get("agent_status", "unknown")
        now[pane] = status
        before = seen.get(pane)
        if before is not None and status != before and pane not in told:
            events.append({"type": "agent", "agent": a, "where": location(snap, a), "for": watching[pane]})
    for pane in seen:
        if pane not in now and pane in watching and pane not in told:
            events.append({"type": "agent", "agent": {"pane_id": pane, "workspace_id": "", "tab_id": "", "agent_status": "gone"},
                           "where": "", "for": watching[pane]})
    seen.clear()
    seen.update(now)
    return events


# ---- what is running (Live Updates) --------------------------------------------------------------

def _short(text, n=160):
    text = str(text or "")
    return text if len(text) <= n else text[:n - 1] + "…"


def live_agents(snap, st, now):
    """The working agents, each with when it started working (as this watcher first saw it)."""
    since = st.setdefault("live_agents_since", {})
    out = []
    for a in snap.get("agents", []):
        pane = a.get("pane_id")
        if not pane or a.get("agent_status") != "working":
            continue
        since.setdefault(pane, int(now))
        keep = ("pane_id", "workspace_id", "tab_id", "agent", "name", "title", "display_agent", "agent_status", "state_change_seq")
        agent = {k: (_short(a[k]) if isinstance(a[k], str) else a[k]) for k in keep if a.get(k) is not None}
        ws = next((w for w in snap.get("workspaces", []) if w.get("workspace_id") == a.get("workspace_id")), {})
        out.append({"agent": agent, "where": _short(location(snap, a), 80), "workspace": _short(ws.get("label"), 80), "since": since[pane]})
    working = {e["agent"]["pane_id"] for e in out}
    for pane in list(since):
        if pane not in working:
            del since[pane]
    return out[:LIVE_MAX]


def live_sigs(event):
    """What starts or stops (sent at once), and that with the rest (sent now and then)."""
    major, minor = [], []
    for e in event.get("agents", []):
        a = e["agent"]
        major.append(["a", a.get("pane_id")])
        minor.append(["a", a.get("pane_id"), a.get("name"), a.get("title")])
    return json.dumps(major), json.dumps(minor)


def live_event(st, agents, now, first):
    """The live event to send now, or None: [agents] is None when not looked at this time."""
    if agents is not None:
        st["live_agents"] = agents
    event = {"type": "live", "agents": st.get("live_agents", [])}
    major, minor = live_sigs(event)
    sent = st.get("live_sent") or {}
    since = now - float(sent.get("at") or 0)
    busy = bool(event["agents"])
    due = (first or not sent or major != sent.get("major")
           or (minor != sent.get("minor") and since >= LIVE_MINOR)
           or (busy and since >= LIVE_KEEP))
    if not due:
        return None
    st["live_sent"] = {"at": now, "major": major, "minor": minor}
    return event


