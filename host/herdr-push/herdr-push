def kernel32():
    """Windows: kernel32 with the signatures of the calls health uses (64-bit safe), loaded once."""
    global _KERNEL32
    if _KERNEL32 is None:
        import ctypes
        from ctypes import wintypes
        k = ctypes.WinDLL("kernel32", use_last_error=True)
        k.GlobalMemoryStatusEx.argtypes = [ctypes.c_void_p]
        k.GlobalMemoryStatusEx.restype = wintypes.BOOL
        k.GetSystemTimes.argtypes = [ctypes.POINTER(wintypes.FILETIME)] * 3
        k.GetSystemTimes.restype = wintypes.BOOL
        k.GetLogicalDrives.argtypes = []
        k.GetLogicalDrives.restype = wintypes.DWORD
        k.GetDriveTypeW.argtypes = [wintypes.LPCWSTR]
        k.GetDriveTypeW.restype = wintypes.UINT
        k.GetDiskFreeSpaceExW.argtypes = [wintypes.LPCWSTR] + [ctypes.POINTER(ctypes.c_ulonglong)] * 3
        k.GetDiskFreeSpaceExW.restype = wintypes.BOOL
        k.SetThreadErrorMode.argtypes = [wintypes.DWORD, ctypes.POINTER(wintypes.DWORD)]
        k.SetThreadErrorMode.restype = wintypes.BOOL
        k.GetTickCount64.argtypes = []
        k.GetTickCount64.restype = ctypes.c_ulonglong
        k.GetCurrentProcessId.argtypes = []
        k.GetCurrentProcessId.restype = wintypes.DWORD
        k.ProcessIdToSessionId.argtypes = [wintypes.DWORD, ctypes.POINTER(wintypes.DWORD)]
        k.ProcessIdToSessionId.restype = wintypes.BOOL
        _KERNEL32 = k
    return _KERNEL32


